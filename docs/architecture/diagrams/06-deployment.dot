digraph deployment {
  graph [
    rankdir=LR,
    splines=spline,
    bgcolor="#ffffff",
    pad="0.4", nodesep="0.3", ranksep="0.7",
    fontname="Helvetica", fontsize="20",
    label="DEPLOYMENT TOPOLOGIES — who talks to whom",
    labelloc=t, labeljust=l
  ];
  node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", color="#94a3b8", penwidth=1.1];
  edge [fontname="Helvetica", fontsize=11, color="#475569", penwidth=1.3];

  subgraph cluster_t1 {
    label="Topology A — one laptop, your phone (today's default)";
    fontsize=14; fontcolor="#0f766e"; color="#5eead4"; style="rounded,filled"; fillcolor="#f0fdfa"; penwidth=2;
    t1_phone [label="1 phone\nPWA + APK + ntfy", fillcolor="#dbeafe", fontcolor="#1e3a8a"];
    t1_relay [label="relay :8787", fillcolor="#d1fae5", fontcolor="#064e3b"];
    t1_o1 [label="opencode serve :4096", fillcolor="#e2e8f0", fontcolor="#0f172a"];
    t1_o2 [label="opencode serve :4097", fillcolor="#e2e8f0", fontcolor="#0f172a"];
    t1_phone -> t1_relay [label="token + SSE + HTTP", color="#0891b2"];
    t1_relay -> t1_o1 [dir=both, color="#10b981"];
    t1_relay -> t1_o2 [dir=both, color="#10b981"];
  }

  subgraph cluster_t2 {
    label="Topology B — many phones, one laptop (family / team)";
    fontsize=14; fontcolor="#0f766e"; color="#5eead4"; style="rounded,filled"; fillcolor="#f0fdfa"; penwidth=2;
    t2_p1 [label="phone A\ntoken 1", fillcolor="#dbeafe", fontcolor="#1e3a8a"];
    t2_p2 [label="phone B\ntoken 2", fillcolor="#dbeafe", fontcolor="#1e3a8a"];
    t2_relay [label="relay :8787\n(same data store)", fillcolor="#d1fae5", fontcolor="#064e3b"];
    t2_ag [label="agents…", fillcolor="#e2e8f0", fontcolor="#0f172a"];
    t2_p1 -> t2_relay; t2_p2 -> t2_relay;
    t2_relay -> t2_ag [color="#10b981"];
  }

  subgraph cluster_t3 {
    label="Topology C — many laptops, one phone (manage every agent everywhere)";
    fontsize=14; fontcolor="#0f766e"; color="#5eead4"; style="rounded,filled"; fillcolor="#f0fdfa"; penwidth=2;
    t3_phone [label="1 phone\n(chats from ALL laptops)", fillcolor="#dbeafe", fontcolor="#1e3a8a"];
    t3_relay1 [label="laptop 1 relay", fillcolor="#d1fae5", fontcolor="#064e3b"];
    t3_relay2 [label="laptop 2 relay", fillcolor="#d1fae5", fontcolor="#064e3b"];
    t3_ag1 [label="opencode :4096", fillcolor="#e2e8f0", fontcolor="#0f172a"];
    t3_ag2 [label="opencode :4096", fillcolor="#e2e8f0", fontcolor="#0f172a"];
    t3_phone -> t3_relay1 [color="#0891b2"];
    t3_phone -> t3_relay2 [color="#0891b2"];
    t3_relay1 -> t3_ag1 [dir=both, color="#10b981"];
    t3_relay2 -> t3_ag2 [dir=both, color="#10b981"];
  }

  subgraph cluster_net {
    label="Underlying network — anything the two ends can reach";
    fontsize=14; fontcolor="#334155"; color="#94a3b8"; style="rounded,filled"; fillcolor="#f8fafc"; penwidth=2;
    net1 [label="localhost", fillcolor="#e2e8f0", fontcolor="#0f172a"];
    net2 [label="Tailscale tailnet\n(phones ↔ PCs)", fillcolor="#e2e8f0", fontcolor="#0f172a"];
    net3 [label="plain LAN\n(what the live demo uses)", fillcolor="#e2e8f0", fontcolor="#0f172a"];
  }

  t1_relay -> net1 [style=dotted, color="#94a3b8"];
  t2_relay -> net2 [style=dotted, color="#94a3b8"];
  t3_phone -> net3 [style=dotted, color="#94a3b8"];
}

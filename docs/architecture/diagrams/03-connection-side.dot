digraph connection_side {
  graph [
    rankdir=LR,
    splines=spline,
    bgcolor="#ffffff",
    pad="0.4", nodesep="0.35", ranksep="0.7",
    fontname="Helvetica", fontsize="20",
    label="CONNECTION SIDE — pairing, transport and security",
    labelloc=t, labeljust=l
  ];
  node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", color="#fcd34d", penwidth=1.1, fillcolor="#fef3c7", fontcolor="#78350f"];
  edge [fontname="Helvetica", fontsize=11, color="#92400e", penwidth=1.3];

  /* pairing flow */
  pair [label="1 · PC prints pair URL\nhttp://10.121.251.1:8787/pair", fillcolor="#fde68a"];
  qr   [label="2 · pair page shows QR\nencoded URL  …/?token=live123", fillcolor="#fde68a"];
  scan [label="3 · phone camera scans QR\nor opens the pair link", fillcolor="#fde68a"];
  tok  [label="4 · token arrives on phone\npre-filled in the login box", fillcolor="#fde68a"];

  /* transport */
  subgraph cluster_transport {
    label="Transport channels (all authenticated)";
    fontsize=15; fontcolor="#0e7490"; color="#67e8f9"; style="rounded,filled"; fillcolor="#ecfeff"; penwidth=2;
    t_sse [label="EventSource (SSE) /api/events\nserver→phone · live feed · replays since lastId", fillcolor="#cffafe"];
    t_http [label="HTTP POST/PUT\nphone→server · prompt · approve · abort · skills", fillcolor="#cffafe"];
    t_ws  [label="WebSocket\nscreenshots · streaming (extensible)", fillcolor="#cffafe"];
  }

  /* network */
  subgraph cluster_net {
    label="Network options";
    fontsize=15; fontcolor="#334155"; color="#94a3b8"; style="rounded,filled"; fillcolor="#f8fafc"; penwidth=2;
    n_local [label="localhost only\n(127.0.0.1 · default)", fillcolor="#e2e8f0", fontcolor="#0f172a"];
    n_tail [label="Tailscale tailnet\nauto-detected *.ts.net IP\nno port forwarding", fillcolor="#e2e8f0", fontcolor="#0f172a"];
    n_lan  [label="plain LAN\nhost 0.0.0.0\n(what the live demo uses)", fillcolor="#e2e8f0", fontcolor="#0f172a"];
  }

  /* security */
  subgraph cluster_sec {
    label="Security model";
    fontsize=15; fontcolor="#9f1239"; color="#fda4af"; style="rounded,filled"; fillcolor="#fff1f2"; penwidth=2;
    s_tok [label="bearer token\n(tied to one PC + phone)", fillcolor="#fecdd3"];
    s_pin [label="optional PIN\n2nd factor", fillcolor="#fecdd3"];
    s_ses [label="session scoping\nphone sees only its PC's agents", fillcolor="#fecdd3"];
    s_allow [label="allowlist\nprompts + skills OK · raw shell off", fillcolor="#fecdd3"];
  }

  pair -> qr -> scan -> tok;
  tok -> t_sse [label="token + ?since=", color="#0891b2"];
  tok -> t_http [label="token header", color="#0891b2"];
  t_sse -> n_tail [style=dotted, color="#94a3b8"];
  t_http -> n_tail [style=dotted, color="#94a3b8"];
  n_local -> n_tail [label="opt-in", style=dashed, dir=none];
  n_tail -> n_lan [label="or", style=dashed, dir=none];
  t_sse -> s_tok [style=dotted];
  t_http -> s_pin [style=dotted];
  t_ws -> s_ses [style=dotted];
  t_http -> s_allow [style=dotted];
}

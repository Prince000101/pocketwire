digraph mobile_side {
  graph [
    rankdir=TB,
    splines=ortho,
    bgcolor="#ffffff",
    pad="0.4", nodesep="0.3", ranksep="0.55",
    fontname="Helvetica", fontsize="20",
    label="MOBILE SIDE — the PWA (and its native Capacitor wrapper)",
    labelloc=t, labeljust=l
  ];
  node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled", color="#93c5fd", penwidth=1.1, fillcolor="#dbeafe", fontcolor="#1e3a8a"];
  edge [fontname="Helvetica", fontsize=11, color="#1e40af", penwidth=1.3];

  subgraph cluster_wrapper {
    label="Delivered as";
    fontsize=14; fontcolor="#7c3aed"; color="#c4b5fd"; style="rounded,filled"; fillcolor="#f5f3ff"; penwidth=2;
    w_pwa [label="Installable PWA\n(service worker · manifest · offline shell)", fillcolor="#ede9fe"];
    w_apk [label="Native APK\nCapacitor 8 · android/ app\niOS generated on a Mac", fillcolor="#ede9fe"];
  }

  subgraph cluster_views {
    label="Screens";
    fontsize=14; fontcolor="#0e7490"; color="#67e8f9"; style="rounded,filled"; fillcolor="#ecfeff"; penwidth=2;
    v_onboard [label="Onboarding / pair\n(token input · link)", fillcolor="#cffafe"];
    v_chats [label="Chat list\navatar · status · preview · unread badge", fillcolor="#cffafe"];
    v_chat  [label="Per-agent chat\nfeed · composer · actions", fillcolor="#cffafe"];
    v_skills [label="Skills sheet\nsearch · tap-to-run", fillcolor="#cffafe"];
    v_approve [label="Approval sheet\nAllow once · Always · Deny", fillcolor="#cffafe"];
    v_settings [label="Settings\ntheme · servers · session · logout", fillcolor="#cffafe"];
  }

  subgraph cluster_logic {
    label="Browser app logic (vanilla JS)";
    fontsize=14; fontcolor="#6d28d9"; color="#c4b5fd"; style="rounded,filled"; fillcolor="#f5f3ff"; penwidth=2;
    l_es [label="EventSource manager\nloadHistory → open stream\n&since=lastId · resume on reconnect", fillcolor="#ede9fe"];
    l_route [label="event router\nagentId → chat feed\napprovals · todos · idle · diffs", fillcolor="#ede9fe"];
    l_theme [label="theme manager\nlight · dark · auto\nlocalStorage 'pocketwire.theme'", fillcolor="#ede9fe"];
    l_phone [label="device detection\nphone vs desktop layout", fillcolor="#ede9fe"];
  }

  subgraph cluster_data {
    label="State & storage";
    fontsize=14; fontcolor="#0e7490"; color="#67e8f9"; style="rounded,filled"; fillcolor="#ecfeff"; penwidth=2;
    d_servers [label="servers[]\nname · url · token · lastId · status", fillcolor="#cffafe"];
    d_agents [label="agents[]\nfrom /api/status", fillcolor="#cffafe"];
    d_store [label="localStorage\nactive server · theme", fillcolor="#cffafe"];
  }

  w_pwa -> v_onboard;
  w_apk -> v_onboard [style=dashed, label="same UI inside WebView"];

  v_onboard -> v_chats;
  v_chats -> v_chat;
  v_chats -> v_settings;
  v_chat -> v_skills;
  v_chat -> v_approve;

  l_es -> v_chat [label="live events", color="#7c3aed"];
  l_route -> v_chat [style=dotted];
  l_theme -> v_settings [style=dotted, dir=both];
  l_phone -> v_chats [style=dotted];

  d_servers -> l_es [style=dotted];
  d_agents -> l_route [style=dotted];
  d_store -> d_servers [dir=none, style=dotted];
  d_store -> l_theme [style=dotted];
}
